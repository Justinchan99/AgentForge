{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "clangd": {
      "command": ["{{CLANGD}}", "--background-index", "--clang-tidy", "--compile-commands-dir={{COMPILE_COMMANDS_DIR}}"],
      "extensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"]
    },
    "pyright": {
      "command": ["{{PYRIGHT}}", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  }
}
